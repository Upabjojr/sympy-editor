__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
examples/*.html
examples/derivations/*.html

# Images are built, never committed: mobile/make_icons.py draws the app's
# icons from mobile/icon/*.svg, and the builds regenerate them.
*.png

# mobile packaging: generated bundle and native build products
mobile/www/
mobile/android/app/src/main/assets/
mobile/android/app/src/main/python/sympy_editor/
mobile/android/app/src/main/python/sympy_editor_app.py
mobile/android/.gradle/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/.idea/
mobile/ios/*.xcodeproj/
mobile/ios/SymPyEditor/Info.plist
# the iOS app's Python: the interpreter (linked into the cache), the app's own
# code and SymPy - all staged by mobile/build.py
mobile/ios/Python.xcframework
mobile/ios/app/
mobile/ios/app_packages/
mobile/android/gradle/wrapper/gradle-wrapper.jar

# web app build
webapp/dist/
mobile/android/.kotlin/

# add-on drafts: the demo page is built, not committed
addons/*.html
addons/*/build/
