{
  "title": "SymPy Editor",
  "description": "A tour of the editor: selecting, Transform (expand, factor, doit), the solver, the source line, undo, the four add-ons - plot, tree, rewrite rules, LaTeX.",
  "expression": "(x + 1)**3*(x - 2)",
  "addons": ["plot", "tree", "matching", "latex"],
  "steps": [
    {"at": 0, "caption": "SymPy Editor: a SymPy expression you edit by pointing at it.", "size": "large", "position": "center", "duration": 3.6},
    {"after": 3.9, "click": {"path": "/0"}, "say": "Click any piece of the formula to select it."},
    {"after": 2.0, "click": ".se-toolbar [data-cmd=\"parent\"]", "say": "The up arrow selects what holds it: the whole product."},
    {"after": 2.0, "click": ".se-ops", "say": "Transform lists what can be done with the selection."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"expand\"]", "say": "Expand multiplies it out - a quartic."},
    {"after": 2.8, "click": ".se-ops", "say": "Factor takes it back apart..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"factor\"]", "say": "...into the factors of its roots: -1 three times, and 2."},
    {"after": 2.8, "type": {"target": ".se-source", "text": "Integral(1/(x**3 + 1), x)", "enter": true}, "say": "The source line takes SymPy input: an integral."},
    {"after": 2.0, "click": ".se-ops", "say": "doit evaluates it..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"doit\"]", "say": "...two logarithms and an arctangent."},
    {"after": 3.2, "click": ".se-toolbar [data-cmd=\"undo\"]", "say": "Undo takes any step back; redo brings it again."},
    {"after": 2.2, "type": {"target": ".se-source", "text": "Eq(a*x**2 + b*x + c, 0)", "enter": true}, "say": "An equation: the general quadratic."},
    {"after": 2.0, "type": {"target": ".se-fn", "text": "solve", "enter": true}, "say": "Any SymPy function applies to it from this box: solve..."},
    {"after": 1.4, "choose": {"target": ".se-fn-form select", "value": "x"}, "say": "...for x..."},
    {"after": 0.9, "click": ".se-fn-form .se-fn-apply", "say": "...and there is the quadratic formula."},
    {"after": 3.2, "type": {"target": ".se-source", "text": "exp(-x**2/y)*cos(z*x)", "enter": true}, "say": "Add-ons bring more. A formula to plot..."},
    {"after": 1.8, "click": ".se-toolbar [data-cmd=\"drawer\"]", "say": "...and the menu that holds the add-ons.", "sayFor": 2.0},
    {"after": 1.0, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "Plot"}, "lead": 0.8, "say": "Switch them on: a plot..."},
    {"after": 0.6, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "Expression tree"}, "lead": 0.6, "say": "...the expression tree..."},
    {"after": 0.6, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "Rewrite rules"}, "lead": 0.6, "say": "...rewrite rules..."},
    {"after": 0.6, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "LaTeX"}, "lead": 0.6, "say": "...and a LaTeX reader."},
    {"after": 1.6, "click": ".se-drawer-close", "lead": 0.6},
    {"after": 1.4, "point": ".se-addon-plot .plot-sliders", "hold": 2.2, "say": "The plot wants a value for every other symbol: y and z."},
    {"after": 0.4, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"y\"] input.plot-value", "text": "4"}, "say": "y = 4..."},
    {"after": 0.8, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"z\"] input.plot-value", "text": "3"}, "say": "...z = 3, and it draws."},
    {"after": 1.4, "point": ".se-addon-plot .plot-area", "hold": 2.2, "say": "A damped wave."},
    {"after": 0.6, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"z\"] input.plot-value", "text": "8"}, "say": "Change z and it redraws: a faster wave."},
    {"after": 2.2, "type": {"target": ".se-addon-plot .plot-bar label:nth-of-type(2) input", "text": "-3"}, "say": "The range, from -3..."},
    {"after": 0.8, "type": {"target": ".se-addon-plot .plot-bar label:nth-of-type(3) input", "text": "3"}, "say": "...to 3: a closer look."},
    {"after": 2.4, "click": {"path": "/0"}, "say": "It plots the selection: now the cosine alone."},
    {"after": 3.0, "click": {"path": "/"}, "say": "The whole formula again."},
    {"after": 2.4, "point": ".se-addon-tree .tree-svg", "hold": 2.6, "say": "The expression's tree: click, drag and edit its nodes."},
    {"after": 1.0, "type": {"target": ".ltx-input", "text": "\\sum_{n=1}^{\\infty} \\frac{1}{n^{2}}", "perChar": 0.04}, "say": "The LaTeX reader: type or paste LaTeX..."},
    {"after": 1.2, "click": ".ltx-read", "say": "...read it..."},
    {"after": 1.4, "click": ".ltx-insert-all", "say": "...and it becomes the formula."},
    {"after": 2.0, "click": ".se-ops", "say": "doit sums it..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"doit\"]", "say": "...the Basel problem: pi squared over six."},
    {"after": 3.2, "type": {"target": ".se-source", "text": "sin(x)**2 + sin(2*x)**2", "enter": true}, "say": "Rewrite rules, with wildcards: a_ matches anything."},
    {"after": 1.8, "type": {"target": ".se-addon-matching input.mt-field", "text": "sin(a_)**2 -> 1 - cos(a_)**2"}, "say": "A rule: sin(a)^2 is 1 - cos(a)^2..."},
    {"after": 0.8, "click": {"selector": ".se-addon-matching button", "text": "Add rule"}},
    {"after": 1.2, "click": {"path": "/"}},
    {"after": 0.8, "click": {"selector": ".se-addon-matching button", "text": "Rewrite"}, "say": "...applied wherever it matches."},
    {"after": 3.4, "caption": "That is SymPy Editor.   pip install sympy-editor", "size": "large", "position": "center", "duration": 4.5}
  ]
}
