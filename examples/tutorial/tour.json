{
  "title": "SymPy Editor",
  "description": "A tour of the editor: editing in the formula itself, Transform (expand, factor, doit), the solver, undo, the History of the edits, and three add-ons - plot, rewrite rules, LaTeX.",
  "expression": "(x + 1)**3*(x - 2)",
  "addons": ["plot", "matching", "latex"],
  "steps": [
    {"at": 0, "caption": "SymPy Editor: a SymPy expression you edit right in the formula.", "size": "large", "position": "center", "duration": 3.6},
    {"after": 3.9, "click": {"path": "/0/1"}, "say": "Click any piece of the formula to select it - here, the exponent."},
    {"after": 1.8, "click": ".se-actions [data-cmd=\"edit\"]", "say": "Edit - or a double-click - opens it right there, in the formula..."},
    {"after": 1.2, "type": {"target": "focused", "text": "4", "enter": true}, "say": "...type the new value, and Enter."},
    {"after": 2.2, "click": {"path": "/1"}, "say": "Any piece at all: this factor..."},
    {"after": 1.2, "click": ".se-actions [data-cmd=\"edit\"]", "lead": 0.8},
    {"after": 0.8, "type": {"target": "focused", "text": "x - 3", "enter": true}, "say": "...becomes x - 3."},
    {"after": 2.2, "click": ".se-toolbar [data-cmd=\"parent\"]", "say": "The up arrow selects what holds it: the whole product."},
    {"after": 2.0, "click": ".se-ops", "say": "Transform lists what can be done with it."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"expand\"]", "say": "Expand multiplies it out - a quintic."},
    {"after": 2.8, "click": ".se-ops", "say": "Factor finds the factors again..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"factor\"]", "say": "...x + 1 four times, and x - 3."},
    {"after": 2.8, "click": {"path": "/"}, "say": "Select the whole formula and write over it: an integral."},
    {"after": 1.0, "click": ".se-actions [data-cmd=\"edit\"]", "lead": 0.8},
    {"after": 0.8, "type": {"target": "focused", "text": "Integral(1/(x**3 + 1), x)", "enter": true}},
    {"after": 2.0, "click": ".se-ops", "say": "doit evaluates it..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"doit\"]", "say": "...two logarithms and an arctangent."},
    {"after": 3.2, "click": ".se-toolbar [data-cmd=\"undo\"]", "say": "Undo takes a step back; redo brings it again."},
    {"after": 1.4, "click": ".se-toolbar [data-cmd=\"redo\"]"},
    {"after": 2.4, "click": {"path": "/"}, "say": "An equation now: the general quadratic."},
    {"after": 1.0, "click": ".se-actions [data-cmd=\"edit\"]", "lead": 0.8},
    {"after": 0.8, "type": {"target": "focused", "text": "Eq(a*x**2 + b*x + c, 0)", "enter": true}},
    {"after": 2.0, "type": {"target": ".se-fn", "text": "solve", "enter": true}, "say": "Any SymPy function applies to it from this box: solve..."},
    {"after": 1.4, "choose": {"target": ".se-fn-form select", "value": "x"}, "say": "...for x..."},
    {"after": 0.9, "click": ".se-fn-form .se-fn-apply", "say": "...and there is the quadratic formula."},
    {"after": 3.2, "click": ".se-toolbar [data-cmd=\"history\"]", "say": "History keeps every edit of the session."},
    {"after": 1.8, "caption": "One step after another: what each edit brought in green, what it took away in red.", "position": "bottom", "duration": 3.4},
    {"after": 3.6, "click": ".se-history-head .se-play-step[title^=\"The next\"]", "say": "Step through the past edits, one at a time...", "position": "below"},
    {"after": 1.5, "click": ".se-history-head .se-play-step[title^=\"The next\"]", "lead": 0.5},
    {"after": 1.5, "click": ".se-history-head .se-play-step[title^=\"The next\"]", "lead": 0.5},
    {"after": 1.5, "click": ".se-history-head .se-play-step[title^=\"The step before\"]", "lead": 0.6, "say": "...forwards and back.", "position": "below"},
    {"after": 1.8, "click": ".se-history-head .se-play", "say": "Or play them, like a slideshow.", "position": "below"},
    {"after": 5.5, "click": ".se-history-close", "lead": 0.8, "say": "Back to the editor."},
    {"after": 2.2, "click": {"path": "/"}, "say": "Add-ons bring more. A formula to plot..."},
    {"after": 1.0, "click": ".se-actions [data-cmd=\"edit\"]", "lead": 0.8},
    {"after": 0.8, "type": {"target": "focused", "text": "exp(-x**2/y)*cos(z*x)", "enter": true}},
    {"after": 1.8, "click": ".se-toolbar [data-cmd=\"drawer\"]", "say": "...and the menu that holds the add-ons.", "sayFor": 2.0},
    {"after": 1.0, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "Plot"}, "lead": 0.8, "say": "Switch them on: a plot..."},
    {"after": 0.6, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "Rewrite rules"}, "lead": 0.6, "say": "...rewrite rules..."},
    {"after": 0.6, "click": {"selector": ".se-drawer-addons label.se-addon-row", "text": "LaTeX"}, "lead": 0.6, "say": "...and a LaTeX reader."},
    {"after": 1.6, "click": ".se-drawer-close", "lead": 0.6},
    {"after": 1.4, "point": ".se-addon-plot .plot-sliders", "hold": 2.2, "say": "The plot wants a value for every other symbol: y and z."},
    {"after": 0.4, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"y\"] input.plot-value", "text": "4"}, "say": "y = 4..."},
    {"after": 0.8, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"z\"] input.plot-value", "text": "3"}, "say": "...z = 3, and it draws."},
    {"after": 1.4, "point": ".se-addon-plot .plot-area", "hold": 2.2, "say": "A damped wave."},
    {"after": 0.6, "type": {"target": ".se-addon-plot .plot-sliders label[data-sym=\"z\"] input.plot-value", "text": "8"}, "say": "Change z and it redraws: a faster wave."},
    {"after": 2.2, "type": {"target": ".se-addon-plot .plot-bar label:nth-of-type(2) input", "text": "-3"}, "say": "The range, from -3..."},
    {"after": 0.8, "type": {"target": ".se-addon-plot .plot-bar label:nth-of-type(3) input", "text": "3"}, "say": "...to 3: a closer look."},
    {"after": 2.4, "click": {"path": "/0"}, "say": "It plots the selection: now the cosine alone."},
    {"after": 3.0, "click": {"path": "/"}, "say": "The whole formula again."},
    {"after": 2.4, "type": {"target": ".ltx-input", "text": "\\sum_{n=1}^{\\infty} \\frac{1}{n^{2}}", "perChar": 0.04}, "say": "The LaTeX reader: type or paste LaTeX..."},
    {"after": 1.2, "click": ".ltx-read", "say": "...read it..."},
    {"after": 1.4, "click": ".ltx-insert-all", "say": "...and it becomes the formula."},
    {"after": 2.0, "click": ".se-ops", "say": "doit sums it..."},
    {"after": 0.9, "click": ".se-pick-menu[data-for=\"se-ops\"] .se-pick-item[data-name=\"doit\"]", "say": "...the Basel problem: pi squared over six."},
    {"after": 3.2, "click": {"path": "/"}, "say": "Rewrite rules, with wildcards: a_ matches anything."},
    {"after": 1.0, "click": ".se-actions [data-cmd=\"edit\"]", "lead": 0.8},
    {"after": 0.8, "type": {"target": "focused", "text": "sin(x)**2 + sin(2*x)**2", "enter": true}},
    {"after": 1.8, "type": {"target": ".se-addon-matching input.mt-field", "text": "sin(a_)**2 -> 1 - cos(a_)**2"}, "say": "A rule: sin(a)^2 is 1 - cos(a)^2..."},
    {"after": 0.8, "click": {"selector": ".se-addon-matching button", "text": "Add rule"}},
    {"after": 1.2, "click": {"path": "/"}},
    {"after": 0.8, "click": {"selector": ".se-addon-matching button", "text": "Rewrite"}, "say": "...applied wherever it matches."},
    {"after": 3.4, "caption": "That is SymPy Editor.   pip install sympy-editor", "size": "large", "position": "center", "duration": 4.5}
  ]
}
